<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= course.name %> - Checkout</title>
  
</head>
<style>
  body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  background-color: #f4f4f4;
}

.course-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-start;
  padding: 20px;
  
}

.course-detail, .checkout-container {
  background: #fff;
  border-radius: 5px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  margin: 10px;
  padding: 20px;
  max-width: 400px;
  width: 100%;
}

.course-img {
  max-width: 100%;
  height: auto;
  border-radius: 5px;
}

.course-title {
  font-size: 24px;
  margin: 10px 0;
}

.course-price {
  font-size: 20px;
  color: #4CAF50;
}

.course-description {
  font-size: 16px;
  color: #555;
}

.checkout-container h2 {
  font-size: 22px;
  margin-bottom: 20px;
}

.form-group {
  margin-bottom: 15px;
}

.form-group label {
  display: block;
  margin-bottom: 5px;
  font-size: 14px;
  color: #333;
}

.form-group input {
  width: 90%;
  padding: 10px;
  font-size: 16px;
  border: 1px solid #ddd;
  border-radius: 5px;
  
}

.checkout-btn {
  width: 100%;
  padding: 15px;
  font-size: 16px;
  background-color: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  transition: background-color 0.3s;
}

.checkout-btn:hover {
  background-color: #45a049;
}

@media (max-width: 768px) {
  .course-container {
    flex-direction: column;
    align-items: center;
  }
}

</style>
<body>
  <div class="course-container">
    <div class="course-detail">
      <img src="<%= course.img %>" alt="<%= course.name %>" class="course-img">
      <h1 class="course-title"><%= course.title %></h1>
      <p class="course-price">$<%= course.price %></p>
      <p class="course-description"><%= course.description %></p>
    </div>
    
    <% if (user) { %>
      <div class="checkout-container">
        <h2>Checkout</h2>
        <form  action="/api/payment/payment" method="post">
          
         
            <label for="email">Pay to Acquire course</label>
            <input type="email" id="email" name="email"  value="<%= user.email %>" hidden>
        

         
            <input type="text" id="email" name="fname"  value="<%= user.firstname %>" hidden>
       

         
            <input type="text" id="email" name="userId"  value="<%= user.user_id %>" hidden>
       

         
            <input type="text" id="email" name="price"  value="<%= course.price %>" hidden>
         
        
       
          <button type="submit" class="checkout-btn">Pay $<%= course.price %></button>
        </form>
      </div>
    <% } else { %>
      <div class="login-prompt">
        <p>Please <a href="/login">log in</a> or <a href="/register">sign up</a> to access the checkout.</p>
      </div>
    <% } %>
  </div>
  </div>
  
  <script>
     document.getElementById('checkout-form').addEventListener('submit', function(event) {
    event.preventDefault();
    // Collect form data
    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());

    fetch('/api/payment/payment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(response => response.text())
    .then(message => {
      alert(message);
      // Optionally, redirect to another page
      // window.location.href = '/confirmation';
    })
    .catch(error => console.error('Error processing payment:', error));

    });
  </script>
</body>
</html>