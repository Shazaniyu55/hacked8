<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<!-- Boxicons -->
	<link href='https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css' rel='stylesheet'>

	<!-- Font Awesome -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

	<!-- Custom CSS -->
	<link rel="stylesheet" href="/dashboard.css">
    <link rel="stylesheet" href="/course-text.css">

	<title>Course Details</title>
</head>
<body>

	<!-- SIDEBAR -->
	<section id="sidebar">
		<ul class="side-menu top">
			<li><a href="/dashboard"><i class='bx bxs-dashboard'></i> <span class="text">Dashboard</span></a></li>
			<li class="active"><a href="/dashboard/course"><i class='bx bxs-shopping-bag-alt'></i> <span class="text">My Courses</span></a></li>
			<li><a href="#"><i class='bx bxs-book'></i> <span class="text">Take Quiz</span></a></li>
			<li><a href="/dashboard/message"><i class='bx bxs-message-dots'></i> <span class="text">Message</span></a></li>
			<li><a href="/dashboard/exams"><i class='bx bx-laptop'></i> <span class="text">Exams</span></a></li>
		</ul>
		<ul class="side-menu">
			<li><a href="/remove" class="logout"><i class='bx bxs-log-out-circle'></i> <span class="text">Logout</span></a></li>
		</ul>
	</section>
	<!-- SIDEBAR -->

	<!-- CONTENT -->
	<section id="content">
		<!-- NAVBAR -->
		<nav>
			<i class='bx bx-menu'></i>
			<a href="/home" class="nav-link">Hacked8</a>
			<a href="/videocall"><i class='bx bx-video' style="cursor: pointer;"></i></a>
			<a href="/profile"><i class='bx bx-user' style="cursor: pointer;"></i></a>
		</nav>
		<!-- NAVBAR -->

		<!-- MAIN -->
		<main>
			<div class="course-container">
				<h1 class="course-title"><%= coursedatapaid.name %></h1>
				<p class="course-description"><%= coursedatapaid.description %></p>

				<!-- Display Course Image -->
				<% if (coursedatapaid.img) { %>
					<img src="<%= coursedatapaid.img %>" alt="Course Image" class="course-image">
				<% } %>

				<!-- Display PDF Link -->
				<% if (coursedatapaid.pdf) { %>
					<div class="pdf-container">
						<a class="pdf-link" href="<%= coursedatapaid.pdf %>" target="_blank">
							View Course PDF <i class="fas fa-file-pdf"></i>
						</a>
					</div>
				<% } else { %>
					<p>No PDF available for this course.</p>
				<% } %>

				<!-- Mark Course as Completed -->
				<div class="buttons">
					<button class="back-button" onclick="window.history.back()">Go Back</button>
					<form id="completeCourseForm">
						<input type="hidden" name="courseId" value="<%= coursedatapaid._id %>">
						<button type="submit" class="complete-button">Mark as Completed</button>
					</form>
				</div>
			</div>
		</main>
		<!-- MAIN -->
	</section>
	<!-- CONTENT -->

	<script>
		document.getElementById('completeCourseForm').addEventListener('submit', async function(event) {
			event.preventDefault();
			const courseId = this.courseId.value;
			
			const response = await fetch('/completeCourse', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ courseId })
			});

			const data = await response.json();
			if (data.status === 'success') {
				alert('Course marked as completed!');
				location.reload();
			} else {
				alert('Error: ' + data.message);
			}
		});
	</script>

</body>
</html>
