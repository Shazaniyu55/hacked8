<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<!-- Boxicons -->
	<link href='https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css' rel='stylesheet'>
	<!-- CodeMirror CSS and JS CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/theme/dracula.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.5/mode/css/css.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

	<!-- My CSS -->
	<link rel="stylesheet" href="/dashboard.css">
    <link rel="stylesheet" href="/d-course.css">

	<title>Dashboard</title>

	<style>
		 #code-editor {
            width: 100%;
            height: 400px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
		/* Table Styles */
#courses-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

#courses-table th,
#courses-table td {
    padding: 12px;
    text-align: left;
    border: 1px solid #ddd;
}

#courses-table th {
    background-color: #4CAF50;
    color: white;
}

#courses-table td {
    background-color: #f9f9f9;
}

#courses-table tr:nth-child(even) {
    background-color: #f2f2f2;
}

#courses-table tr:hover {
    background-color: #ddd;
}

/* Progress Bar Styles */
.progress-container {
    width: 100%;
    background-color: #e0e0e0;
    border-radius: 10px;
    overflow: hidden;
    height: 10px;
    margin-top: 5px;
}

.progress-bar {
    height: 100%;
    background-color: #4caf50;
    transition: width 0.5s ease-in-out;
}

/* Style for progress value in the table */
td .progress-container {
    margin-top: 5px;
}

/* Topic Checkbox Styles */
#courses-table td ul {
    list-style-type: none;
    padding-left: 0;
}

#courses-table td ul li {
    margin: 5px 0;
}

#courses-table td ul li input[type="checkbox"] {
    margin-right: 10px;
}

#courses-table td ul li input[type="checkbox"]:checked {
    background-color: #4caf50;
}




	</style>
</head>
<body>


	<!-- SIDEBAR -->
	<section id="sidebar">
		
		<ul class="side-menu top">
			<li >
				<a href="/dashboard">
					<i class='bx bxs-dashboard' ></i>
					<span class="text">Dashboard</span>
				</a>
			</li>
			<li class="active">
				<a href="/dashboard/course">
					<i class='bx bxs-shopping-bag-alt' ></i>
					<span class="text">My Courses</span>
				</a>
			</li>

			<li>
				<a href="#">
					<i class='bx bxs-book' ></i>
					<span class="text">Take Quiz</span>
				</a>
			</li>
			
			<li>
				<a href="/dashboard/message">
					<i class='bx bxs-message-dots' ></i>
					<span class="text">Message</span>
				</a>
			</li>



            <li>
				<a href="/dashboard/exams">
					<i class='bx bx-laptop'></i>
					<span class="text">Exams</span>
				</a>
			</li>
<!-- 
			<li>
				<a href="/dashboard/profile/<%= user.user_id %>">
					<i class='bx bxs-user' ></i>
					<span class="text">Profile</span>
				</a>
			</li> -->
			
		</ul>
		<ul class="side-menu">
			
			<li>
				<a href="/remove" class="logout">
					<i class='bx bxs-log-out-circle' ></i>
					<span class="text">Logout</span>
				</a>
			</li>
		</ul>
	</section>
	<!-- SIDEBAR -->



	<!-- CONTENT -->
	<section id="content">
		<!-- NAVBAR -->
		<nav>
			<i class='bx bx-menu' ></i>
			<a href="/home" class="nav-link">Hacked8</a>
			
		
			
            <a href="/videocall"><i class='bx bx-video' style="cursor: pointer;"></i></a>
			<a href="/profile"><i class='bx bx-user' style="cursor: pointer;"></i></a>

			
		</nav>
		<!-- NAVBAR -->

		<!-- MAIN -->
		<main>
			<div class="head-title">
				<div class="left">
					<h2 id="groupNameHeader" class="group name">Courses</h2>
					
				</div>
				
			</div>
			






            <div class="toc">

                <div class="cl">
                   <a href="/dashboard/course"><i class="fa-solid fa-arrow-left"></i></a> 
                </div>


                <h2>Table of Contents</h2>
				<ul>
					<% courseDatapaid.topics.forEach(topic => { %>
					  <li> <a href="/dashboard/courses/course-text/<%= courseDatapaid.id %>"><%= topic.title %>: <%= topic.content %></a> </li>
					<% }); %>
				  </ul>
				  
            </div>

			




           
         
			


			
		</main>
		<!-- MAIN -->
	</section>
	<!-- CONTENT -->
	<!-- Textarea for CodeMirror -->

    

	

	<script src="/dash.js"></script>
</body>
</html>