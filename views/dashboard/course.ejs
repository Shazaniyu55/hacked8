	<!-- Textarea for CodeMirror -->

    

	<script>
		 // Initialize CodeMirror
		 const editor = CodeMirror.fromTextArea(document.getElementById("code-editor"), {
    lineNumbers: true, // Show line numbers
    mode: "htmlmixed",  // Set the mode to HTML/JS/CSS
    theme: "dracula",   // Set the theme (you can use other themes too)
    htmlMode: true,     // Allow HTML-specific syntax highlighting
    tabSize: 2,         // Set the tab size
    indentUnit: 2,      // Set the indentation size
    lineWrapping: true, // Allow line wrapping
  });

		const API_URL = "https://hacked8-one.vercel.app";

// Fetch courses and update UI
async function fetchCourses() {
    const response = await fetch(`${API_URL}/courses`);
    const courses = await response.json();
    
    let totalProgress = 0;
    let totalCourses = courses.length;
	console.log(totalCourses)

    const courseList = document.getElementById("course-list");
    courseList.innerHTML = "";

    courses.forEach(course => {
        const progress = calculateProgress(course);
        totalProgress += parseFloat(progress);

        const courseItem = document.createElement("tr");
        courseItem.innerHTML = `
            <h3>${course.title} - <span id="progress-${course.id}"></span></h3>
			<td>
				 ${progress}% 
            <div class="progress-container">
                <div id="progress-bar-${course.id}" class="progress-bar" style="width: ${progress}%;"></div>
            </div>
           

			</td>
        `;

        courseList.appendChild(courseItem);
    });

    // Update total progress
    let averageProgress = (totalCourses > 0) ? (totalProgress / totalCourses).toFixed(2) : 0;
    document.getElementById("total-progress").innerText = `${averageProgress}%`;
    document.getElementById("progress-bar").style.width = `${averageProgress}%`;
}

// Calculate progress for a single course
function calculateProgress(course) {
    const totalTopics = course.topics.length;
    const completedTopics = course.topics.filter(topic => topic.completed).length;
    return ((completedTopics / totalTopics) * 100).toFixed(2);
}

// Mark a topic as complete and update UI instantly
async function markTopicComplete(courseId, topicId) {
    const response = await fetch(`${API_URL}/mark-complete`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ courseId, topicId })
    });

    if (response.ok) {
        // Update UI instantly
        const courseElement = document.querySelector(`#progress-${courseId}`);
        const progressBar = document.querySelector(`#progress-bar-${courseId}`);

        // Get the latest progress for the course
        const updatedResponse = await fetch(`${API_URL}/courses`);
        const updatedCourses = await updatedResponse.json();
        const updatedCourse = updatedCourses.find(c => c.id === courseId);
        const newProgress = calculateProgress(updatedCourse);

        if (courseElement && progressBar) {
            courseElement.innerText = `${newProgress}%`;
            progressBar.style.width = `${newProgress}%`;
        }

        fetchCourses(); // Refresh all courses
    } else {
        console.error("Failed to mark topic as complete");
    }
}

// Load courses on page load
fetchCourses();



	</script>

