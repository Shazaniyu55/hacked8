	<!-- Textarea for CodeMirror -->

    <script>
        const API_URL = "https://hacked8-one.vercel.app";

        async function fetchCourses() {
            const response = await fetch(`${API_URL}/courses`);
            const courses = await response.json();
            console.log(courses);

            courses.forEach(course => {
                const progress = calculateProgress(course);
                console.log(`Progress for course ${course._id}: ${progress}%`);

                // Find the matching exam card for this course
                const examCard = document.querySelector(`.exam-card[data-course-id="${course._id}"]`);
                if (examCard) {
                    let status = progress === 100 ? "unlocked" : "locked";
                    updateExamStatus(examCard, status);
                }
            });
        }

        function calculateProgress(course) {
            if (!course.topics || course.topics.length === 0) return 0;

            const totalTopics = course.topics.length;
            const completedTopics = course.topics.filter(topic => topic.completed).length;

            let progress = ((completedTopics / totalTopics) * 100).toFixed(2);
            return parseFloat(progress);
        }

        function updateExamStatus(card, status) {
            const icon = card.querySelector(".status-icon");
            icon.className = "status-icon";
            card.setAttribute("data-status", status);

            switch (status) {
                case "unlocked":
                    icon.innerHTML = "<abbr title='Unlocked'><i class='fa-solid fa-unlock' style='color: #ff9000;'></i></abbr>";
                    icon.classList.add("unlocked");
                    card.classList.add("clickable");
                    card.onclick = () => document.querySelector(".popup").classList.add("active");
                    break;

                case "locked":
                default:
                    icon.innerHTML = "<abbr title='Locked'><i class='bx bxs-lock-alt' style='color:#ff9000'></i></abbr>";
                    icon.classList.add("locked");
                    card.classList.remove("clickable");
                    card.onclick = null;
            }
        }

        fetchCourses();

        document.querySelector(".fa-close").addEventListener("click", function(){
            document.querySelector(".popup").classList.remove("active");
        });

        document.querySelector(".sub").addEventListener("click", function(e){
            e.preventDefault();
            window.location.href = '/cbt';
        });

    </script>
    

    


