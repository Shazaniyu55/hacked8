		/* Table Styles */
#courses-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

#courses-table th,
#courses-table td {
    padding: 12px;
    text-align: left;
    border: 1px solid #ddd;
}

#courses-table th {
    background-color: #4CAF50;
    color: white;
}

#courses-table td {
    background-color: #f9f9f9;
}

#courses-table tr:nth-child(even) {
    background-color: #f2f2f2;
}

#courses-table tr:hover {
    background-color: #ddd;
}

/* Progress Bar Styles */
.progress-container {
    width: 100%;
    background-color: #e0e0e0;
    border-radius: 10px;
    overflow: hidden;
    height: 10px;
    margin-top: 5px;
}

.progress-bar {
    height: 100%;
    background-color: #4caf50;
    transition: width 0.5s ease-in-out;
}

/* Style for progress value in the table */
td .progress-container {
    margin-top: 5px;
}

/* Topic Checkbox Styles */
#courses-table td ul {
    list-style-type: none;
    padding-left: 0;
}

#courses-table td ul li {
    margin: 5px 0;
}

#courses-table td ul li input[type="checkbox"] {
    margin-right: 10px;
}

#courses-table td ul li input[type="checkbox"]:checked {
    background-color: #4caf50;
}




