/* Progress Bar Styles */
.progress-container {
    width: 100%;
    background-color: #e0e0e0;
    border-radius: 10px;
    overflow: hidden;
    height: 10px;
    margin-top: 5px;
}

.progress-bar {
    height: 100%;
    background-color: #4caf50;
    transition: width 0.5s ease-in-out;
}

/* Style for progress value in the table */
td .progress-container {
    margin-top: 5px;
}

/* Topic Checkbox Styles */
