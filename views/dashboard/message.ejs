    <script>
        // Define the group names here
        const groups = [
            "FrontEnd Web",
            "Backend Web",
            "FrontEnd App",
            "Backend App",
            "Cyber security",
            "Ethical Hacking"
        ];
        
        let currentGroup = "";  // This will store the current group selected

        // Populate the group list dynamically
        const groupList = document.getElementById("groupList");
        groups.forEach(group => {
            const listItem = document.createElement("li");
            listItem.textContent = group;
            listItem.addEventListener("click", () => enterGroup(group));
            groupList.appendChild(listItem);
        });

        // Show the group chat page and set the group name in the header
        function enterGroup(group) {
            currentGroup = group;
            document.getElementById("joinGroupPage").classList.add("hidden");
            document.getElementById("chatPage").classList.remove("hidden");
            document.getElementById("backBtn").classList.add("active");

            // Update the group name in the chat header
            document.getElementById("groupNameHeader").textContent = `${group} Chat`;
            
            loadChatMessages(group);  // Load previous chat messages for the selected group
        }

        // Go back to the group selection page
        document.getElementById("backBtn").addEventListener("click", () => {
            document.getElementById("chatPage").classList.add("hidden");
            document.getElementById("joinGroupPage").classList.remove("hidden");
            document.getElementById("backBtn").classList.remove("active");

            document.getElementById("groupNameHeader").textContent = "Messages";
        });

        // Load previous messages for a group (Simulating with static messages here)
// Simulating loading previous messages with classes 'them' for others' messages
function loadChatMessages(group) {
    const chatMessages = document.getElementById("chatMessages");
    chatMessages.innerHTML = ""; // Clear existing messages
    
    // Simulating loading previous messages
    const messages = [
        { user: "User 1", message: "Hello, welcome to " + group + "!" },
        { user: "User 2", message: "Hi everyone!" }
    ];

    messages.forEach((msg, index) => {
        const messageDiv = document.createElement("div");
        
        // Add the class 'them' for others' messages
        messageDiv.classList.add('chat-message', 'them');
        
        messageDiv.textContent = `${msg.user}: ${msg.message}`;
        chatMessages.appendChild(messageDiv);
    });
}

// When sending a new message
document.getElementById("sendBtn").addEventListener("click", () => {
    const messageInput = document.getElementById("messageInput");
    const message = messageInput.value.trim();
    if (message) {
        const chatMessages = document.getElementById("chatMessages");
        const messageDiv = document.createElement("div");

        // Add the class 'me' for your own messages
        messageDiv.classList.add('chat-message', 'me');
        
        messageDiv.textContent = `You: ${message}`;
        chatMessages.appendChild(messageDiv);
        messageInput.value = "";  // Clear the input field after sending the message
    }
});



